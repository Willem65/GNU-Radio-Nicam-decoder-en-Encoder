- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\nfrom collections\
      \ import deque\n\nclass blk(gr.sync_block):\n    \"\"\"UDP-PDU's naar een ononderbroken\
      \ bytestroom, met filler zodra\n    de buffer leeg is. Buffergrootte is nu gekoppeld\
      \ aan een maximale\n    vertraging in plaats van een vast aantal bytes.\"\"\"\
      \n\n    def __init__(self, filler_byte=0, max_latency_sec=2.0, channel_bytes_per_sec=150):\n\
      \        gr.sync_block.__init__(\n            self,\n            name='PDU naar\
      \ continue stream (met filler, beperkte latency)',\n            in_sig=None,\n\
      \            out_sig=[np.uint8]\n        )\n        self.filler_byte = int(filler_byte)\
      \ & 0xFF\n        # Buffergrootte = max_latency_sec * kanaalcapaciteit.\n  \
      \      # Zodra dit vol is, vallen de OUDSTE bytes vanzelf weg (deque-gedrag),\n\
      \        # zodat de vertraging nooit verder oploopt dan max_latency_sec.\n \
      \       max_bytes = max(1, int(max_latency_sec * channel_bytes_per_sec))\n \
      \       self.buf = deque(maxlen=max_bytes)\n        self.message_port_register_in(pmt.intern('pdus'))\n\
      \        self.set_msg_handler(pmt.intern('pdus'), self.handle_pdu)\n\n    def\
      \ handle_pdu(self, msg):\n        data = pmt.cdr(msg)\n        if pmt.is_u8vector(data):\n\
      \            self.buf.extend(pmt.u8vector_elements(data))\n\n    def work(self,\
      \ input_items, output_items):\n        out = output_items[0]\n        for i\
      \ in range(len(out)):\n            out[i] = self.buf.popleft() if self.buf else\
      \ self.filler_byte\n        return len(out)\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\
      \n\n# import numpy as np\n# from gnuradio import gr\n# import pmt\n# from collections\
      \ import deque\n\n# class blk(gr.sync_block):\n    # \"\"\"UDP-PDU's naar een\
      \ ononderbroken bytestroom, met filler zodra de buffer leeg is\"\"\"\n\n   \
      \ # def __init__(self, filler_byte=0):\n        # gr.sync_block.__init__(\n\
      \            # self,\n            # name='PDU naar continue stream (met filler)',\n\
      \            # in_sig=None,\n            # out_sig=[np.uint8]\n        # )\n\
      \        # self.filler_byte = int(filler_byte) & 0xFF\n        # # maxlen voorkomt\
      \ dat de buffer eindeloos opzwelt als UDP sneller\n        # # binnenkomt dan\
      \ er wordt uitgezonden; oudste bytes vallen dan vanzelf af\n        # self.buf\
      \ = deque(maxlen=1_000_000)\n        # self.message_port_register_in(pmt.intern('pdus'))\n\
      \        # self.set_msg_handler(pmt.intern('pdus'), self.handle_pdu)\n\n   \
      \ # def handle_pdu(self, msg):\n        # data = pmt.cdr(msg)\n        # if\
      \ pmt.is_u8vector(data):\n            # self.buf.extend(pmt.u8vector_elements(data))\n\
      \n    # def work(self, input_items, output_items):\n        # out = output_items[0]\n\
      \        # for i in range(len(out)):\n            # out[i] = self.buf.popleft()\
      \ if self.buf else self.filler_byte\n        # return len(out)\n        \n \
      \       "
    affinity: ''
    alias: ''
    channel_bytes_per_sec: '15000'
    comment: ''
    filler_byte: '85'
    max_latency_sec: '2'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('PDU naar continue stream (met filler, beperkte latency)', 'blk',
      [('filler_byte', '0'), ('max_latency_sec', '2.0'), ('channel_bytes_per_sec',
      '150')], [('pdus', 'message', 1)], [('0', 'byte', 1)], "UDP-PDU's naar een ononderbroken
      bytestroom, met filler zodra\n    de buffer leeg is. Buffergrootte is nu gekoppeld
      aan een maximale\n    vertraging in plaats van een vast aantal bytes.", ['filler_byte'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [384, 192.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\n\n\nclass\
      \ blk(gr.sync_block):\n    \"\"\"Corrigeert ongeldige packet_len-tags EN injecteert\
      \ zelf een\n    synthetische tag als er te lang geen geldige detectie binnenkomt,\n\
      \    zodat repack_bits_bb nooit zonder tag komt te zitten.\"\"\"\n\n    def\
      \ __init__(self, tag_name='packet_len', max_len=3000, safe_len=2080):\n    \
      \    gr.sync_block.__init__(\n            self,\n            name='Packet-len\
      \ tag validator',\n            in_sig=[np.uint8],\n            out_sig=[np.uint8]\n\
      \        )\n        self.tag_name = tag_name\n        self.max_len = int(max_len)\n\
      \        self.safe_len = int(safe_len)\n        self.set_tag_propagation_policy(gr.TPP_DONT)\n\
      \        self.next_expected_offset = None  # absolute stream-offset\n\n    def\
      \ work(self, input_items, output_items):\n        in0 = input_items[0]\n   \
      \     out = output_items[0]\n        n = len(in0)\n        out[:] = in0\n\n\
      \        start_offset = self.nitems_read(0)\n        end_offset = start_offset\
      \ + n\n\n        tags = self.get_tags_in_window(0, 0, n)\n        real_tags\
      \ = []\n        for tag in tags:\n            key = pmt.symbol_to_string(tag.key)\n\
      \            if key != self.tag_name:\n                continue\n          \
      \  real_tags.append(tag)\n\n        # Eerste keer: begin gewoon te tellen vanaf\
      \ nu.\n        if self.next_expected_offset is None:\n            self.next_expected_offset\
      \ = start_offset\n\n        pos = start_offset\n        for tag in sorted(real_tags,\
      \ key=lambda t: t.offset):\n            # Gat vullen: als er tussen 'pos' en\
      \ deze tag een te grote\n            # afstand zit zonder enige tag, synthetische\
      \ tags inschuiven.\n            while self.next_expected_offset < tag.offset:\n\
      \                self.add_item_tag(\n                    0, self.next_expected_offset,\n\
      \                    pmt.intern(self.tag_name),\n                    pmt.from_long(self.safe_len)\n\
      \                )\n                self.next_expected_offset += self.safe_len\n\
      \n            value = pmt.to_long(tag.value)\n            if value <= 0 or value\
      \ > self.max_len:\n                corrected = self.safe_len\n            else:\n\
      \                corrected = value\n\n            self.add_item_tag(0, tag.offset,\
      \ tag.key, pmt.from_long(corrected))\n            self.next_expected_offset\
      \ = tag.offset + corrected\n\n        # Ook binnen dit werkblok vooruitkijken:\
      \ als er geen enkele tag\n        # was, maar we toch de verwachte grens overschrijden,\
      \ alvast vullen.\n        while self.next_expected_offset < end_offset:\n  \
      \          self.add_item_tag(\n                0, self.next_expected_offset,\n\
      \                pmt.intern(self.tag_name),\n                pmt.from_long(self.safe_len)\n\
      \            )\n            self.next_expected_offset += self.safe_len\n\n \
      \       return n"
    affinity: ''
    alias: ''
    comment: ''
    max_len: '3000'
    maxoutbuf: '0'
    minoutbuf: '0'
    safe_len: '2080'
    tag_name: '"packet_len"'
  states:
    _io_cache: ('Packet-len tag validator', 'blk', [('tag_name', "'packet_len'"),
      ('max_len', '3000'), ('safe_len', '2080')], [('0', 'byte', 1)], [('0', 'byte',
      1)], 'Corrigeert ongeldige packet_len-tags EN injecteert zelf een\n    synthetische
      tag als er te lang geen geldige detectie binnenkomt,\n    zodat repack_bits_bb
      nooit zonder tag komt te zitten.', ['max_len', 'safe_len', 'tag_name'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1296, 768.0]
    rotation: 0
    state: enabled
- name: epy_block_2
  id: epy_block
  parameters:
    _source_code: "import subprocess\nfrom gnuradio import gr\nimport pmt\n\n\nclass\
      \ blk(gr.sync_block):\n    \"\"\"Start ffplay als los proces zodra er een bericht\
      \ binnenkomt\n    via de QT GUI Message Button.\"\"\"\n\n    def __init__(self,\
      \ udp_port=12345):\n        gr.sync_block.__init__(\n            self,\n   \
      \         name='Start ffplay button handler',\n            in_sig=None,\n  \
      \          out_sig=None\n        )\n        self.udp_port = int(udp_port)\n\
      \        self.process = None\n        self.message_port_register_in(pmt.intern('start'))\n\
      \        self.set_msg_handler(pmt.intern('start'), self.handle_msg)\n\n    def\
      \ handle_msg(self, msg):\n        if self.process is not None and self.process.poll()\
      \ is None:\n            print(\"[ffplay] draait al, negeer nieuwe klik.\")\n\
      \            return\n\n        ffplay_cmd = (\n            f'ffplay -loglevel\
      \ error -fflags +discardcorrupt+genpts+nobuffer '\n            f'-err_detect\
      \ ignore_err -max_delay 500000 '\n            f'-f mpegts -i udp://127.0.0.1:{self.udp_port}'\n\
      \        )\n\n        full_cmd = (\n            f'echo Start ffplay op poort\
      \ {self.udp_port}... & '\n            f'echo Commando: {ffplay_cmd} & '\n  \
      \          f'echo. & '\n            f'{ffplay_cmd} & '\n            f'echo.\
      \ & '\n            f'echo ffplay is gestopt (druk op een toets om dit venster\
      \ te sluiten) & '\n            f'pause >nul'\n        )\n\n        print(f\"\
      [ffplay] Start: {ffplay_cmd}\")\n        self.process = subprocess.Popen(\n\
      \            [\"cmd\", \"/c\", full_cmd],\n            creationflags=subprocess.CREATE_NEW_CONSOLE\n\
      \        )\n\n    def stop(self):\n        if self.process is not None and self.process.poll()\
      \ is None:\n            self.process.terminate()\n        return True"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    udp_port: '12345'
  states:
    _io_cache: ('Start ffplay button handler', 'blk', [('udp_port', '12345')], [('start',
      'message', 1)], [], 'Start ffplay als los proces zodra er een bericht binnenkomt\n    via
      de QT GUI Message Button.', ['udp_port'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1600, 984.0]
    rotation: 0
    state: enabled
- name: epy_block_3
  id: epy_block
  parameters:
    _source_code: "import os\nimport tempfile\nimport subprocess\nfrom gnuradio import\
      \ gr\nimport pmt\n\n\nclass blk(gr.sync_block):\n    \"\"\"Start ffmpeg als\
      \ los proces zodra er een bericht binnenkomt\n    via de QT GUI Message Button.\"\
      \"\"\n\n    def __init__(self, audio_device='CABLE-C Output (VB-Audio Cable\
      \ C)',\n                 udp_port=1234):\n        gr.sync_block.__init__(\n\
      \            self,\n            name='Start ffmpeg button handler',\n      \
      \      in_sig=None,\n            out_sig=None\n        )\n        self.audio_device\
      \ = str(audio_device)\n        self.udp_port = int(udp_port)\n        self.process\
      \ = None\n        self.message_port_register_in(pmt.intern('start'))\n     \
      \   self.set_msg_handler(pmt.intern('start'), self.handle_msg)\n\n    def handle_msg(self,\
      \ msg):\n        if self.process is not None and self.process.poll() is None:\n\
      \            print(\"[ffmpeg] draait al, negeer nieuwe klik.\")\n          \
      \  return\n\n        ffmpeg_cmd = (\n            f'ffmpeg -f dshow -i audio=\"\
      {self.audio_device}\" '\n            f'-c:a aac -b:a 128k -ac 2 -ar 48000 -muxrate\
      \ 200k '\n            f'-f mpegts udp://127.0.0.1:{self.udp_port}'\n       \
      \ )\n\n        # Schrijf het commando naar een tijdelijk .bat-bestand om\n \
      \       # problemen met haakjes/aanhalingstekens in cmd te vermijden.\n    \
      \    bat_path = os.path.join(tempfile.gettempdir(), \"start_ffmpeg_audio.bat\"\
      )\n        with open(bat_path, \"w\") as f:\n            f.write(\"@echo off\\\
      r\\n\")\n            f.write(\"echo Start ffmpeg audio-encoder...\\r\\n\")\n\
      \            f.write(f\"echo Apparaat: {self.audio_device}\\r\\n\")\n      \
      \      f.write(f\"echo Commando: {ffmpeg_cmd}\\r\\n\")\n            f.write(\"\
      echo.\\r\\n\")\n            f.write(f\"{ffmpeg_cmd}\\r\\n\")\n            f.write(\"\
      echo.\\r\\n\")\n            f.write(\"echo ffmpeg is gestopt (druk op een toets\
      \ om dit venster te sluiten)\\r\\n\")\n            f.write(\"pause >nul\\r\\\
      n\")\n\n        print(f\"[ffmpeg] Start via: {bat_path}\")\n        self.process\
      \ = subprocess.Popen(\n            [\"cmd\", \"/c\", bat_path],\n          \
      \  creationflags=subprocess.CREATE_NEW_CONSOLE\n        )\n\n    def stop(self):\n\
      \        if self.process is not None and self.process.poll() is None:\n    \
      \        self.process.terminate()\n        return True"
    affinity: ''
    alias: ''
    audio_device: '"CABLE-C Output (VB-Audio Cable C)"'
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    udp_port: '1234'
  states:
    _io_cache: ('Start ffmpeg button handler', 'blk', [('audio_device', "'CABLE-C
      Output (VB-Audio Cable C)'"), ('udp_port', '1234')], [('start', 'message', 1)],
