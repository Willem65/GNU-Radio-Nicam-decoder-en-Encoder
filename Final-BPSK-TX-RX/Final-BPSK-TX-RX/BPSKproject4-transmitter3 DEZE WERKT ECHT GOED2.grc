- name: epy_block_timestamp_end
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\nimport\
      \ time\n\nclass blk(gr.sync_block):\n    \"\"\"Print een tijdstempel telkens\
      \ als er een packet_len-tag voorbijkomt.\"\"\"\n\n    def __init__(self, label='END',\
      \ tag_name='packet_len'):\n        gr.sync_block.__init__(\n            self,\n\
      \            name='Packet Timestamp Logger',\n            in_sig=[np.uint8],\n\
      \            out_sig=[np.uint8]\n        )\n        self.label = label\n   \
      \     self.tag_name = tag_name\n\n    def work(self, input_items, output_items):\n\
      \        in0 = input_items[0]\n        out = output_items[0]\n        out[:]\
      \ = in0\n        n = len(in0)\n        tags = self.get_tags_in_window(0, 0,\
      \ n)\n        for tag in tags:\n            key = pmt.symbol_to_string(tag.key)\n\
      \            if key == self.tag_name:\n                print(f\"[{self.label}]\
      \ {time.time():.3f}  offset={tag.offset}\")\n        return n"
    affinity: ''
    alias: ''
    comment: ''
    label: '"END (na Stream CRC32 check)"'
    maxoutbuf: '0'
    minoutbuf: '0'
    tag_name: '"packet_len"'
  states:
    _io_cache: ('Packet Timestamp Logger', 'blk', [('label', "'END'"), ('tag_name',
      "'packet_len'")], [('0', 'byte', 1)], [('0', 'byte', 1)], 'Print een tijdstempel
      telkens als er een packet_len-tag voorbijkomt.', ['label', 'tag_name'])
    bus_sink: false
    bus_source: false
    bus_structure: null
